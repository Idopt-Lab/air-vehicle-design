(prop) edge [DataLine] (prop-wts)
(geom) edge [DataLine] (geom-aero)
(geom) edge [DataLine] (geom-miss)
(geom) edge [DataLine] (geom-wts)
(aero) edge [DataLine] (aero-ddiag)
(aero) edge [DataLine] (aero-miss)
(miss) edge [DataLine] (miss-close)
(wts) edge [DataLine] (wts-close)
(ddiag) edge [DataLine] (ddiag-solver)
(close) edge [DataLine] (close-solver)
(solver) edge [DataLine] (left_output_solver)
(miss) edge [DataLine] (left_output_miss)
% Vertical edges
(solver-prop) edge [DataLine] (prop)
(solver-ddiag) edge [DataLine] (ddiag)
(solver-miss) edge [DataLine] (miss)
(solver-wts) edge [DataLine] (wts)
(prop-geom) edge [DataLine] (geom)
(prop-ddiag) edge [DataLine] (ddiag)
(prop-miss) edge [DataLine] (miss)
(prop-wts) edge [DataLine] (wts)
(geom-aero) edge [DataLine] (aero)
(geom-miss) edge [DataLine] (miss)
(geom-wts) edge [DataLine] (wts)
(aero-ddiag) edge [DataLine] (ddiag)
(aero-miss) edge [DataLine] (miss)
(miss-close) edge [DataLine] (close)
(wts-close) edge [DataLine] (close)
(ddiag-solver) edge [DataLine] (solver)
(close-solver) edge [DataLine] (solver)
(solver) edge [DataLine] (output_solver)
(prop) edge [DataLine] (output_prop)
(geom) edge [DataLine] (output_geom)
(aero) edge [DataLine] (output_aero)
(ddiag) edge [DataLine] (output_ddiag)
(miss) edge [DataLine] (output_miss)
(wts) edge [DataLine] (output_wts)
(close) edge [DataLine] (output_close);
\end{pgfonlayer}

