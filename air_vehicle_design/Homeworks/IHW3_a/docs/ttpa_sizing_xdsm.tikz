% XDSM process chains
{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (solver);
\chainin (prop) [join=by ProcessHVA];
\chainin (geom) [join=by ProcessHVA];
\chainin (aero) [join=by ProcessHVA];
\chainin (ddiag) [join=by ProcessHVA];
\chainin (miss) [join=by ProcessHVA];
\chainin (wts) [join=by ProcessHVA];
\chainin (close) [join=by ProcessHVA];
\chainin (solver) [join=by ProcessHVA];
\end{pgfonlayer}
}

\begin{pgfonlayer}{data}
\path
% Horizontal edges
(solver) edge [DataLine] (solver-prop)
(solver) edge [DataLine] (solver-ddiag)
(solver) edge [DataLine] (solver-miss)
(solver) edge [DataLine] (solver-wts)
(prop) edge [DataLine] (prop-geom)
