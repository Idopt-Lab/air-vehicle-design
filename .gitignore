/air_vehicle_design/mbse/examples/ex2/resources/project

# Generated F-16A sanity-check reports (regenerable by sanity_checks/*.m);
# .gitkeep tracked so the folder exists on a fresh clone
/air_vehicle_design/sizing/examples/F16A/output/*
!/air_vehicle_design/sizing/examples/F16A/output/.gitkeep

# Generated B777-200LR study + sanity-check reports (regenerable by
# studies/*.m and sanity_checks/*.m); .gitkeep tracked so the folder exists
/air_vehicle_design/sizing/examples/B777/output/*
!/air_vehicle_design/sizing/examples/B777/output/.gitkeep

# Generated Aero 481 Design01 study + sanity-check reports (regenerable by
# studies/*.m and sanity_checks/*.m); .gitkeep tracked so the folder exists
/air_vehicle_design/sizing/examples/Aero481/output/*
!/air_vehicle_design/sizing/examples/Aero481/output/.gitkeep

# ---------------------------------------------------------------------------
# Teaching packages (air_vehicle_design/sizing/teaching/<lesson>/)
#
# Tracked: the SOURCES only -- mlx_src/*.m, guide_src/*.tex|.md|.sh|.html,
# guide_src/tikz/*.tex, guide_src/mermaid/*.mmd + rendered art, the package
# helpers, and the README. Everything below is GENERATED by
# make_student_package.m and must never be committed -- in particular the
# framework/ copy, which would duplicate src/ and examples/ verbatim.
# ---------------------------------------------------------------------------

# The framework copy and every generated artefact inside the shippable folder
/air_vehicle_design/sizing/teaching/*/student_package/framework/
/air_vehicle_design/sizing/teaching/*/student_package/**/*.mlx
/air_vehicle_design/sizing/teaching/*/student_package/guide/Sizing_Guide.pdf
/air_vehicle_design/sizing/teaching/*/student_package/guide/Sizing_Guide.md
/air_vehicle_design/sizing/teaching/*/student_package/guide/diagrams.html
/air_vehicle_design/sizing/teaching/*/student_package/guide/figures/
/air_vehicle_design/sizing/teaching/*/student_package/lab/LAB_worksheet.pdf
/air_vehicle_design/sizing/teaching/*/student_package/output/*
!/air_vehicle_design/sizing/teaching/*/student_package/output/.gitkeep

# The zip you upload to Canvas. Rebuild it; do not commit it.
/air_vehicle_design/sizing/teaching/**/*.zip

# LaTeX build products. TeX Live rebuilds these in seconds.
/air_vehicle_design/sizing/teaching/*/guide_src/.texbuild*/
/air_vehicle_design/sizing/teaching/*/guide_src/tikz/*.pdf
/air_vehicle_design/sizing/teaching/*/guide_src/tikz/*.png
/air_vehicle_design/sizing/teaching/*/guide_src/tikz/*.aux
/air_vehicle_design/sizing/teaching/*/guide_src/tikz/*.log

# MATLAB-generated guide figures. Rebuild with make_matlab_figures.m.
/air_vehicle_design/sizing/teaching/*/guide_src/figures_matlab/

# NOTE: guide_src/mermaid/*.svg and *.png ARE tracked on purpose. Rendering
# them needs mermaid-cli, which downloads a headless browser, so a fresh
# clone without network access can still build the guide.
